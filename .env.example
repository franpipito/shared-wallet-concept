# ── Supabase ───────────────────────────────────────────────────────────────
# Dejá estas dos VACÍAS para correr la app en modo mock (sin backend).
# En cuanto NEXT_PUBLIC_SUPABASE_URL tenga valor, la app usa Supabase de verdad.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el seed (scripts/seed.ts). NUNCA la expongas en el cliente
# ni la commitees: crea usuarios y saltea RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Modo demo ──────────────────────────────────────────────────────────────
# Habilita /demo y el auto-login de los dos "celulares". Dejalo en false
# en cualquier despliegue que no sea la demo.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=reserva-demo-2026
